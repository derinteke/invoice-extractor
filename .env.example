# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Run `python scripts/list_models.py` to see which models your key can call.
# gemini-3.1-flash-lite has a usable free quota; gemini-3.5-flash is a bit sharper
# but its free tier is only ~20 requests/day — too few for the full eval.
GEMINI_MODEL=gemini-3.1-flash-lite
# Requests per minute; keep under your free-tier limit
GEMINI_RPM=8
# How ambiguous dates like 10/01/2024 are written: DMY (TR/EU) or MDY (US)
DATE_ORDER=DMY

# Optional local comparison (ollama pull qwen2.5vl:3b)
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_HOST=http://localhost:11434
